Options -Indexes
DirectoryIndex index.php

# ── LiteSpeed/proxy sayfa önbelleğini kapat ──────────────────────────────────
# Uygulama canlı DB verisi gösterir; sunucu tam-sayfa önbelleği dashboard gibi
# sayfaları veri güncellendikten sonra bile eski HTML'le sunar. Kapatıyoruz.
<IfModule LiteSpeed>
    CacheDisable public /
    RewriteEngine On
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# config.php ve .env dosyalarına doğrudan erişimi engelle (Apache 2.4+)
<FilesMatch "^(config\.php|\.env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # uploads/ dizinindeki tüm PHP dosyalarını engelle
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L]

    # HTTPS yönlendirmesi için aşağıdaki satırı aktif edin:
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# uploads/ içinden PHP motorunu kapat (mod_php varsa)
<IfModule mod_php.c>
    <FilesMatch "^uploads/">
        php_flag engine off
    </FilesMatch>
</IfModule>
