Options -Indexes
DirectoryIndex index.php

# config.php ve .env dosyalarına doğrudan erişimi engelle
<FilesMatch "^(config\.php|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# uploads/ dizininden PHP çalıştırmayı engelle
<IfModule mod_php.c>
    <Directory uploads>
        php_flag engine off
    </Directory>
</IfModule>

# uploads/ içindeki PHP dosyalarını direkt engelle (.htaccess override için)
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar)$">
    <If "%{REQUEST_URI} =~ m#^/uploads/#">
        Order allow,deny
        Deny from all
    </If>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # uploads/ dizinindeki tüm PHP isteklerini engelle
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L]

    # HTTPS yönlendirmesi için aşağıdaki satırı aktif edin:
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
