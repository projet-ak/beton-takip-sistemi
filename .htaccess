Options -Indexes
DirectoryIndex index.php

# config.php ve .env dosyalarına doğrudan erişimi engelle (Apache 2.4+)
<FilesMatch "^(config\.php|\.env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # uploads/ dizinindeki tüm PHP dosyalarını engelle
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L]

    # HTTPS yönlendirmesi için aşağıdaki satırı aktif edin:
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
